# GoTrue (Supabase Auth) — LOCAL DEV ONLY. All values are placeholders.
# Standalone GoTrue per BUILD_PLAN T0.2 (not the full Supabase stack). See PRD §2.2/§2.3.
# NOTE (empirical, supabase/gotrue v2.158.1): this build reads some keys unprefixed
# (API_EXTERNAL_URL, DATABASE_URL) and others with the GOTRUE_ prefix — verified by
# probing the binary. Keep this exact spelling mix or config load fails "required key ... missing".
API_EXTERNAL_URL=http://localhost:9999
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
GOTRUE_DB_DRIVER=postgres
GOTRUE_LOG_LEVEL=info

GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=["http://localhost:5173"]

# Dev JWT secret (shared with api .env for verifying GoTrue-issued JWTs). Replace in prod.
GOTRUE_JWT_SECRET=dev-only-gotrue-jwt-secret-min-32-characters!!

GOTRUE_OPERATOR_TOKEN=dev-operator-token

# Email auth (dev: auto-confirm, deliver via local Mailpit)
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=mailpit
GOTRUE_SMTP_PORT=1025
GOTRUE_SMTP_ADMIN_EMAIL=admin@meshpoke.local
GOTRUE_SMTP_MAX_FREQUENCY=1s

# Phone auth — Twilio placeholders (test mode). Test OTP pins fixed codes for the listed
# +852 test numbers so local signup needs no real Twilio account. (Spelling verified at T2.1.)
GOTRUE_SMS_AUTOCONFIRM=false
GOTRUE_SMS_PROVIDER=twilio
GOTRUE_SMS_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
GOTRUE_SMS_TWILIO_AUTH_TOKEN=dev-placeholder-token
GOTRUE_SMS_TWILIO_MESSAGE_SERVICE_SID=MG00000000000000000000000000000000
GOTRUE_SMS_TEST_OTP="+85290000001:123456,+85290000002:123456"
GOTRUE_SMS_TEST_OTP_VALIDITY=600

# Social OAuth — disabled until real creds exist (fill at T2.1+)
GOTRUE_EXTERNAL_APPLE_ENABLED=false
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=dev-placeholder
GOTRUE_EXTERNAL_APPLE_SECRET=dev-placeholder
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=dev-placeholder
GOTRUE_EXTERNAL_GOOGLE_SECRET=dev-placeholder
