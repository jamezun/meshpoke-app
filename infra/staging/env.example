# copy to .env.staging and fill; keys list only — real values are gitignored
NODE_ENV=
DATABASE_URL=
REDIS_URL=
GOTRUE_URL=
GOTRUE_JWT_SECRET=
GOTRUE_SERVICE_ROLE_KEY=
CORS_ORIGINS=
RATE_LIMIT_MAX=
PII_ENCRYPTION_KEY=
QR_HMAC_SECRET=
ADMIN_BOOTSTRAP_PASSWORD=
GOTRUE_SITE_URL=
GOTRUE_URI_ALLOW_LIST=
GOTRUE_DB_DRIVER=
GOTRUE_DB_DATABASE_URL=
GOTRUE_JWT_EXP=
GOTRUE_DISABLE_SIGNUP=
GOTRUE_EXTERNAL_EMAIL_ENABLED=
GOTRUE_MAILER_AUTOCONFIRM=
GOTRUE_SMS_AUTOCONFIRM=
GOTRUE_LOG_LEVEL=
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth (market-standard login). Create at console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (Web application):
#   Authorized JS origin:    https://www.meshpoke.com
#   Authorized redirect URI: https://auth-staging.meshpoke.com/v1/callback
# Apple (App Store requires it when Google is offered): developer.apple.com → Certificates, IDs & Profiles → Services ID
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://auth-staging.meshpoke.com/v1/callback
GOTRUE_EXTERNAL_APPLE_ENABLED=false
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=
GOTRUE_EXTERNAL_APPLE_SECRET=
GOTRUE_EXTERNAL_APPLE_REDIRECT_URI=https://auth-staging.meshpoke.com/v1/callback
