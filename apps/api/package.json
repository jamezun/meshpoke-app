{
  "name": "@meshpoke/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bash scripts/db-generate.sh",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "anonymize": "tsx src/jobs/anonymize-deleted.ts",
    "fehd:import": "tsx scripts/fehd-import.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.0",
    "@types/proj4": "^2.19.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.14.0",
    "pino-pretty": "^11.2.0",
    "socket.io-client": "^4.8.1",
    "testcontainers": "^10.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@meshpoke/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "jose": "^6.2.13",
    "pg": "^8.13.0",
    "pg-boss": "^12.38.0",
    "pino": "^9.5.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "stripe": "^23.0.1",
    "zod": "^3.23.8"
  }
}