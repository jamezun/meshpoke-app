# MeshPoke API — environment contract (PRD §2). Copy to .env and fill in.
# Local-dev values must match infra/docker-compose.dev.yml.

# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database / cache ---
DATABASE_URL=postgres://postgres:postgres_dev_2026@localhost:5432/meshpoke
REDIS_URL=redis://localhost:6379

# --- Auth (standalone GoTrue; see infra/gotrue.dev.env) ---
GOTRUE_URL=http://localhost:9999
GOTRUE_JWT_SECRET=dev-only-gotrue-jwt-secret-min-32-characters!!

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=MeshPoke <no-reply@meshpoke.com>

# --- Billing: Stripe (web) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Billing: RevenueCat (IAP) ---
REVENUECAT_PUBLIC_SDK_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- R2 photo storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meshpoke-photos
R2_PUBLIC_BASE_URL=

# --- Secrets ---
# 32-byte hex (openssl rand -hex 32) — encrypts PII columns at rest
PII_ENCRYPTION_KEY=
# QR token signing (openssl rand -hex 32)
QR_HMAC_SECRET=

# --- Analytics / errors ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://hk.i.posthog.com
SENTRY_DSN=

# --- Bootstrap admin (used once at first boot to create the first admin) ---
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
